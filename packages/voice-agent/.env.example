# LiveKit Cloud — DEDICATED farmacia project (not the colmado one)
LIVEKIT_URL=wss://your-farmacia-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# STT
DEEPGRAM_API_KEY=your_deepgram_key

# LLM providers (which one is used per call comes from Store.voice_config)
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# TTS providers (only the ones you plan to enable in voice_config)
ELEVEN_API_KEY=
CARTESIA_API_KEY=
# Google TTS needs GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON

# Neo Farmacia API (tools → command router). COMMAND_BEARER = the N8N_API_KEY value.
FARMACIA_API_URL=https://api.leofarmacia.com
COMMAND_BEARER=your_n8n_api_key
