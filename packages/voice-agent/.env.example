# LiveKit Cloud — DEDICATED farmacia project (not the colmado one)
LIVEKIT_URL=wss://your-farmacia-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# STT
DEEPGRAM_API_KEY=your_deepgram_key

# LLM providers (which one is used per call comes from Store.voice_config)
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# TTS providers (only the ones you plan to enable in voice_config).
# Cartesia (sonic) streams natively → lowest per-turn latency; recommended for
# production. OpenAI tts-1 (the built-in fallback) does NOT stream.
ELEVEN_API_KEY=
CARTESIA_API_KEY=          # set to enable streaming TTS, then voice_config.tts_provider=cartesia
# Google TTS needs GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON

# Neo Farmacia API (tools → command router). COMMAND_BEARER = the N8N_API_KEY value.
FARMACIA_API_URL=https://api.leofarmacia.com
COMMAND_BEARER=your_n8n_api_key

# ── Outbound SIP: mid-call third-party consult (e.g. insurance) ──
# Leave the trunk vars blank to disable the consultar_seguro tool. Pick ONE mode
# — full setup: docs/plans/voice-third-party-consult.md
# Mode 1 (recommended): a pre-created LiveKit outbound trunk; just set its id.
SIP_TRUNK_ID=             # LiveKit outbound trunk id, e.g. ST_xxxxxxxx
# Mode 2 (inline): Telnyx trunk creds passed per call (used only if SIP_TRUNK_ID is blank)
SIP_TRUNK_HOSTNAME=        # e.g. sip.telnyx.com
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
SIP_FROM_NUMBER=           # your Telnyx number in E.164, e.g. +18095551234
# Demo: a number you control that plays "insurance"; production: the real line
THIRD_PARTY_NUMBER=
