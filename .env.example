# ============================================
# Neo Farmacia - Environment Variables
# ============================================
# Copy to .env and fill in values.
# In production these are set in Dokploy → Environment (never hardcoded in
# docker-compose.dokploy.yml). The API boots fail-closed in production:
# it crashes if JWT_SECRET is the dev default or N8N_API_KEY is empty.

# ---- General ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public-facing URLs (webhook callbacks + signed customer call links)
API_PUBLIC_URL=https://api.leofarmacia.com
APP_PUBLIC_URL=https://app.leofarmacia.com

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/neo_farmacia

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Odoo 17 ----
ODOO_URL=http://localhost:8069
ODOO_DB=neo_farmacia
ODOO_USER=admin
ODOO_PASSWORD=admin
# DB master password (database management / provisioning clones the catalog)
ODOO_MASTER_PASSWORD=admin
# Source DB for the master catalog cloned into each new pharmacy (empty = ODOO_DB)
MASTER_CATALOG_DB=

# ---- Evolution API (WhatsApp) ----
EVOLUTION_API_URL=https://evo.onrpa.com
EVOLUTION_MASTER_KEY=your_master_key

# ---- Meilisearch (shared infra) ----
MEILISEARCH_URL=https://melisearch.onrpa.com
MEILISEARCH_API_KEY=your_meili_key

# ---- n8n ----
N8N_WEBHOOK_URL=https://automations.onrpa.com/webhook/neo-farmacia
# Order events (✗ item rejected, etc) — AI writes the customer notice.
# Empty = fall back to a plain template sent directly via Evolution.
N8N_ORDER_EVENT_WEBHOOK_URL=

# ---- Voice (LiveKit Cloud — dedicated farmacia project) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- JWT Auth ----
JWT_SECRET=change_this_to_a_random_256bit_string
JWT_EXPIRATION=86400000

# ---- API Keys ----
N8N_API_KEY=shared_key_for_n8n_callbacks

# ---- Docs ----
# Set DOCS_ENABLED=false to hide the Swagger UI at /docs in production
DOCS_ENABLED=true

# ---- Dashboard ----
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
